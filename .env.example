# ==============================================================================
# Starfall-Go Debrid v1.2 — Production Environment Configuration Sample
# Target: 2 vCPU / 4 GB RAM VPS (Ubuntu 24.04 LTS / Debian 12)
#
# USAGE ON VPS:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Secure permissions so only root can read your credentials:
#      chmod 600 .env
#   3. Edit with your active credentials:
#      nano .env
#   4. Restart the bot container:
#      docker compose up -d --force-recreate
#
# SECURITY NOTE:
#   .env is in .gitignore and will NEVER be pushed to GitHub.
#   Never commit your bot tokens, API keys, or VPS IP to the public repo!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Required Credentials
# ------------------------------------------------------------------------------
# Owner Telegram User ID (numeric, e.g. 8814651149)
STARFALL_TELEGRAM_OWNER_ID=8814651149

# Telegram API ID and Hash (from https://my.telegram.org)
STARFALL_TELEGRAM_API_ID=
STARFALL_TELEGRAM_API_HASH=

# Primary Telegram Bot Token (from @BotFather, e.g. 123456789:ABCdefGHI...)
STARFALL_TELEGRAM_BOT_TOKEN=

# Optional: User Session String (Pyrogram / Telethon string for 4GB Premium uploads)
STARFALL_TELEGRAM_SESSION_STRING=

# Helper Upload Bot Tokens (Space-separated bot tokens for parallel MTProto uploading)
# Example: "bot_token_1 bot_token_2 bot_token_3"
STARFALL_TELEGRAM_HELPER_TOKENS=

# ------------------------------------------------------------------------------
# 2. Database & MongoDB Configuration
# ------------------------------------------------------------------------------
# Paste your MongoDB connection URI below (e.g. from MongoDB Atlas):
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DATABASE_URL=
STARFALL_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Public Web Studio & VPS IP Configuration
# ------------------------------------------------------------------------------
# Base URL for Web Studio UI, download links, and Telegram /web magic link.
# Replace with your actual VPS IP or custom domain!
# Example: http://172.105.52.160:8080 or https://yourdomain.com
STARFALL_APP_PUBLIC_BASE_URL=http://your_vps_ip_here:8080

# Web server listen address inside the container (default 0.0.0.0:8080)
STARFALL_APP_LISTEN_ADDR=0.0.0.0:8080

# Secret key for signing 30-day Web Studio JWT session cookies (min 32 chars)
STARFALL_AUTH_JWT_SECRET=change_this_to_a_random_secure_hex_key_32_chars_or_more

# ------------------------------------------------------------------------------
# 3. Optional External Integrations
# ------------------------------------------------------------------------------
# TMDb API Read Access Token or v3 API Key for poster rendering & anime metadata
STARFALL_ENGINE_TMDB_API_KEY=

# Google Drive API Key or Folder ID
STARFALL_ENGINE_GDRIVE_API_KEY=

# Google OAuth 2.0 (Optional — private deployment auto-authenticates the Owner)
STARFALL_AUTH_GOOGLE_CLIENT_ID=
STARFALL_AUTH_GOOGLE_CLIENT_SECRET=
STARFALL_AUTH_GOOGLE_REDIRECT_URL=http://your_vps_ip_here:8080/auth/google/callback

# ------------------------------------------------------------------------------
# 4. Hardware Resource Shields (Pre-tuned for 2 vCPU / 4 GB RAM)
# ------------------------------------------------------------------------------
GOMEMLIMIT=3000MiB
GOGC=50
GOMAXPROCS=2
STARFALL_MEMORY_SOFT_LIMIT_MIB=3000
STARFALL_MEMORY_HARD_CEILING_MIB=3200
STARFALL_NETWORK_MAX_GLOBAL_CONNS=150
STARFALL_NETWORK_MAX_CONNS_PER_TASK=30
STARFALL_ENGINE_MAX_CONCURRENT_WORKERS=4
STARFALL_ENGINE_MAX_ACTIVE_DOWNLOADS=3
STARFALL_ENGINE_MAX_TELEGRAM_UPLOADS=2
STARFALL_ENGINE_MAX_LOSSLESS_REMUX=1
